{
  "manifest_version": 3,
  "name": "SUAP Atividades Scraper",
  "version": "1.2",
  "description": "Extrai atividades do Planejamento Estrategico do SUAP para o Supabase",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://suap.ifrn.edu.br/*",
    "https://mnqhwyrzhgykjlyyqodd.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://suap.ifrn.edu.br/documento_eletronico/*"
      ],
      "js": [
        "clone-document.js"
      ],
      "run_at": "document_idle"
    }
  ]
}