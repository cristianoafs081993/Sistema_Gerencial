{
  "manifest_version": 3,
  "name": "Suape - Canivete Suico do IFRN",
  "version": "1.9.24",
  "description": "Resumo de processos, caminho BPMN, dados financeiros, atalhos, pesquisa Ctrl+K e documentos com IA no SUAP e no Comprasnet.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://suap.ifrn.edu.br/*"
      ],
      "css": [
        "command-palette.css"
      ],
      "js": [
        "extension-auth-client.js",
        "command-palette.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "text-expander.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },

    {
      "matches": [
        "https://suap.ifrn.edu.br/documento_eletronico/*"
      ],
      "js": [
        "clone-document-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://suap.ifrn.edu.br/documento_eletronico/*"
      ],
      "js": [
        "clone-document.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://suap.ifrn.edu.br/processo_eletronico/processo/*",
        "https://suap.ifrn.edu.br/processo_eletronico/visualizar_processo/*",
        "https://suap.ifrn.edu.br/documento_eletronico/visualizar_documento/*",
        "https://suap.ifrn.edu.br/documento_eletronico/*"
      ],
      "css": [
        "process-toolkit.css"
      ],
      "js": [
        "extension-auth-client.js",
        "process-document.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://suap.ifrn.edu.br/plan_estrategico/plano_concluido/8/"
      ],
      "js": [
        "extension-auth-client.js",
        "plan-summary.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.siages.com.br/planejamento/campus*"
      ],
      "js": [
        "siages-plan-sync.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cnetmobile.estaleiro.serpro.gov.br/*"
      ],
      "css": [
        "comprasnet-etp.css"
      ],
      "js": [
        "extension-auth-client.js",
        "comprasnet-etp.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
