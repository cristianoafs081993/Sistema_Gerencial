{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/suap-extensao/despacho",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://suap.ifrn.edu.br"
        }
      ]
    },
    {
      "source": "/suap-extensao/processo-info",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://suap.ifrn.edu.br"
        }
      ]
    },
    {
      "source": "/suap-extensao/plano-resumo",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://suap.ifrn.edu.br"
        }
      ]
    },
    {
      "source": "/suap-extensao/documento-analise",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://suap.ifrn.edu.br"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api-transparencia/:path*",
      "destination": "https://api.portaldatransparencia.gov.br/:path*"
    },
    {
      "source": "/api-contratos/:path*",
      "destination": "https://contratos.comprasnet.gov.br/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
